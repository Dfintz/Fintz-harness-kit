# Harness Kit — Environment Variables
#
# Copy this file to .env (gitignored) and fill in the values you need.
# Most variables have sensible defaults; only set what you actually want to override.
#
# NEVER commit real API keys to git. This file is a template only.

# =============================================================================
# HARNESS CORE
# =============================================================================

# Absolute or relative path to the project root containing harness.config.json.
# Default: auto-detected from script location or CWD.
# HARNESS_REPO_ROOT=

# Path to an alternative harness.config.json.
# Default: <HARNESS_REPO_ROOT>/harness.config.json
# HARNESS_CONFIG_PATH=

# Set to 1 to enforce strict config schema validation (fails on unknown keys).
# Default: off
# HARNESS_CONFIG_STRICT=0

# Default agent command used by run-loop.mjs when --agent is not passed.
# Default: "claude -p"
# HARNESS_AGENT_CMD=claude -p

# Directory for live stage state and approvals log.
# Default: .github/harness/runs
# HARNESS_STATE_DIR=

# =============================================================================
# LOCAL LLM — OLLAMA (default provider)
# =============================================================================

# LLM provider: "ollama" (default) or "lmstudio"
# HARNESS_LLM_PROVIDER=ollama

# Ollama base URL. Also read as OLLAMA_HOST for backward compatibility.
# Default: http://localhost:11434
# HARNESS_LLM_HOST=http://localhost:11434
# OLLAMA_HOST=http://localhost:11434

# Default generation model for ollama-agent.mjs and ollama-apply-agent.mjs.
# HARNESS_LLM_MODEL=qwen2.5:14b
# HARNESS_OLLAMA_MODEL=qwen2.5:14b

# Optional system prompt for Ollama generation calls.
# HARNESS_OLLAMA_SYSTEM=

# Optional temperature override (0.0–1.0).
# HARNESS_OLLAMA_TEMPERATURE=

# Optional max tokens for generation.
# HARNESS_OLLAMA_NUM_PREDICT=

# =============================================================================
# LOCAL LLM — LM STUDIO (alternative provider)
# =============================================================================

# LM Studio base URL (OpenAI-compatible API).
# Default: http://localhost:1234
# HARNESS_LLM_HOST=http://localhost:1234

# =============================================================================
# EMBEDDING (vector-search.mjs + file-search.mjs)
# =============================================================================

# Embedding model to use with Ollama or LM Studio.
# Default: nomic-embed-text
# HARNESS_EMBED_MODEL=nomic-embed-text

# Max characters per document fed to the embedding model.
# Default: 4000
# HARNESS_EMBED_MAX_TEXT_CHARS=4000

# Embedding request timeout in milliseconds. Increase for slow CPU inference.
# Default: 60000 (1 minute). Recommended for CPU-only: 120000 (2 minutes).
# HARNESS_EMBED_TIMEOUT_MS=60000

# =============================================================================
# FILESYSTEM INDEX (file-search.mjs / vector-search --scope fs)
# =============================================================================

# Default root directory for filesystem indexing (--root flag overrides this).
# Default: repo root
# HARNESS_FS_ROOT=

# Characters per sliding-window chunk.
# Default: 2000
# HARNESS_FS_CHUNK_SIZE=2000

# Overlap between consecutive chunks.
# Default: 200
# HARNESS_FS_CHUNK_OVERLAP=200

# Skip files larger than this (bytes). 512 KB default.
# HARNESS_FS_MAX_FILE_BYTES=524288

# Comma-separated file extensions to index. See file-search.mjs --help for defaults.
# HARNESS_FS_EXTENSIONS=.md,.txt,.js,.mjs,.ts,.py,.sh

# =============================================================================
# HARNESS PROXY (harness-proxy.mjs — Open WebUI integration)
# =============================================================================

# Listen port for the harness Ollama proxy.
# Default: 11435
# HARNESS_PROXY_PORT=11435

# Bind address for the proxy. Use 0.0.0.0 only in trusted networks.
# Default: 127.0.0.1
# HARNESS_PROXY_HOST=127.0.0.1

# Upstream Ollama URL that the proxy forwards to.
# Default: http://localhost:11434
# HARNESS_PROXY_OLLAMA_HOST=http://localhost:11434

# Max request body size the proxy will accept (bytes). Default: 4 MB.
# HARNESS_PROXY_MAX_BODY_BYTES=4194304

# Set to 0 to disable harness stage-plan injection (pure transparent proxy mode).
# Default: 1 (injection enabled)
# HARNESS_PROXY_INJECT=1

# =============================================================================
# DASHBOARD (report-server.mjs)
# =============================================================================

# Port for the harness dashboard server.
# Default: 8099
# HARNESS_DASHBOARD_PORT=8099

# Bind address for the dashboard. Default: 127.0.0.1 (localhost only).
# HARNESS_DASHBOARD_HOST=127.0.0.1

# How often to regenerate the report (seconds).
# Default: 60
# HARNESS_DASHBOARD_INTERVAL_SECONDS=60

# =============================================================================
# GRAPH PROVIDER
# =============================================================================

# Active knowledge-graph provider: "understand-anything" (default) or "graphify".
# HARNESS_GRAPH_PROVIDER=understand-anything

# Path to the understand-anything plugin checkout (for graph-refresh sidecar).
# UNDERSTAND_PLUGIN_ROOT=/abs/path/to/understand-anything-plugin

# Graphify connection (when provider=graphify).
# GRAPHIFY_HOST=
# GRAPHIFY_URL=
# GRAPHIFY_PROJECT_ID=
# GRAPHIFY_API_KEY=

# =============================================================================
# GRAPH REFRESH LOOP (graph-refresh-loop.mjs)
# =============================================================================

# GRAPH_REFRESH_INTERVAL_SECONDS=600
# GRAPH_REFRESH_RUN_ONCE=false
# GRAPH_REFRESH_AUTO_COMMIT=false
# GRAPH_REFRESH_BOOTSTRAP_PLUGIN=true
# GRAPH_REFRESH_RUNTIME_PLUGIN_ROOT=.cache/understand-plugin-runtime

# =============================================================================
# EXPERIMENT LOOPS
# =============================================================================

# HARNESS_EXPERIMENT_TARGETS=src/path/to/file.ts
# HARNESS_EXPERIMENT_INTERVAL_SECONDS=30
# HARNESS_EXPERIMENT_COMMIT=0

# =============================================================================
# CLOUD LLM PROVIDERS (for GitHub Models / council review)
# =============================================================================

# GitHub Models API key (set GITHUB_TOKEN or COPILOT_API_KEY).
# COPILOT_API_KEY=

# Anthropic Claude direct API.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# Google Gemini.
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.5-pro

# Azure OpenAI.
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_MODEL=

# =============================================================================
# HTTP ADAPTER — v2.6.0 (planned)
# =============================================================================

# API key for the harness HTTP adapter (REST MCP exposure).
# HARNESS_API_KEY=

# Port for the HTTP adapter server.
# HARNESS_HTTP_PORT=8100

# Public URL of the HTTP adapter (used for Teams card action callbacks).
# HARNESS_HTTP_URL=http://localhost:8100

# =============================================================================
# TEAMS INTEGRATION — v2.9.0 (planned)
# =============================================================================

# Teams incoming webhook URL for Adaptive Card notifications.
# HARNESS_TEAMS_WEBHOOK_URL=

# =============================================================================
# SECURITY & OPTIONAL GATES
# =============================================================================

# Custom Lurkr scan command (optional static capability-risk scanner).
# HARNESS_LURKR_COMMAND=npx lurkr scan .

# Docker executable override.
# HARNESS_DOCKER_EXECUTABLE=docker

# Research file path (harness-ingest.mjs --latest output).
# HARNESS_RESEARCH_FILE=
