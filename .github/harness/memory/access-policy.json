{
  "enabled": false,
  "rolloutProfile": "permissive",
  "rolloutProfiles": {
    "permissive": {
      "defaultAllow": true,
      "description": "Rollout mode: allow unclassified memory while domain zones tighten progressively."
    },
    "deny-first": {
      "defaultAllow": false,
      "description": "Strict mode: deny unclassified memory unless explicitly allowed by zone rules."
    }
  },
  "defaultAllow": true,
  "starterTags": [
    "hr",
    "finance",
    "legal",
    "security",
    "it",
    "sales",
    "management"
  ],
  "zones": [
    {
      "id": "hr-memory",
      "description": "Restrict HR-tagged memory to HR principals.",
      "match": {
        "tags": ["hr"],
        "pathPrefixes": [
          ".github/harness/memory/lessons/",
          ".github/harness/memory/briefs/",
          ".github/harness/memory/reviews/"
        ]
      },
      "allow": {
        "roles": ["hr", "admin"],
        "teams": ["hr"]
      },
      "defaultAllow": false
    },
    {
      "id": "finance-memory",
      "description": "Restrict finance-tagged memory to finance principals.",
      "match": {
        "tags": ["finance"]
      },
      "allow": {
        "roles": ["finance", "admin"],
        "teams": ["finance"]
      },
      "defaultAllow": false
    },
    {
      "id": "legal-memory",
      "description": "Restrict legal-tagged memory to legal principals.",
      "match": {
        "tags": ["legal"]
      },
      "allow": {
        "roles": ["legal", "admin"],
        "teams": ["legal"]
      },
      "defaultAllow": false
    },
    {
      "id": "security-memory",
      "description": "Restrict security-tagged memory to security principals.",
      "match": {
        "tags": ["security"]
      },
      "allow": {
        "roles": ["security", "admin"],
        "teams": ["security"]
      },
      "defaultAllow": false
    },
    {
      "id": "it-memory",
      "description": "Restrict IT-tagged memory to IT principals.",
      "match": {
        "tags": ["it"]
      },
      "allow": {
        "roles": ["it", "admin"],
        "teams": ["it"]
      },
      "defaultAllow": false
    },
    {
      "id": "sales-memory",
      "description": "Restrict sales-tagged memory to sales principals.",
      "match": {
        "tags": ["sales"]
      },
      "allow": {
        "roles": ["sales", "admin"],
        "teams": ["sales"]
      },
      "defaultAllow": false
    },
    {
      "id": "management-memory",
      "description": "Restrict management-tagged memory to management principals.",
      "match": {
        "tags": ["management"]
      },
      "allow": {
        "roles": ["management", "admin"],
        "teams": ["management"]
      },
      "defaultAllow": false
    }
  ]
}
