{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-kit.local/harness/skill-openai-sidecar.schema.json",
  "title": "Harness Skill OpenAI Sidecar",
  "description": "Strict contract for .github/skills/<slug>/agents/openai.yaml",
  "type": "object",
  "required": ["interface", "policy"],
  "properties": {
    "interface": {
      "type": "object",
      "required": ["display_name", "short_description"],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "short_description": {
          "type": "string",
          "minLength": 12,
          "maxLength": 220
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["allow_implicit_invocation", "behavior_class"],
      "properties": {
        "allow_implicit_invocation": {
          "type": "boolean"
        },
        "behavior_class": {
          "type": "string",
          "enum": [
            "user-invoked-only",
            "explicit-invocation-required",
            "model-invoked-eligible"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
