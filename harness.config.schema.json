{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./harness.config.schema.json",
  "title": "Harness Config",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "command": { "type": "string" },
              "vars": { "type": "object", "additionalProperties": true }
            },
            "required": ["command"]
          }
        ]
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "useFor": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "sidecarPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "description": { "type": "string" },
        "modelInvokedEligibleSkills": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "modelPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "description": { "type": "string" },
        "activePhase": { "type": "string" },
        "domainSpecialists": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "tier": { "type": "string" },
              "primary": { "type": "string" },
              "fallback": {
                "type": "array",
                "items": { "type": "string" }
              },
              "useFor": { "type": "string" },
              "companionSkills": {
                "type": "array",
                "items": { "type": "string" }
              },
              "reviewPairing": { "type": "string" }
            }
          },
          "properties": {
            "description": { "type": "string" },
            "advisoryOnly": { "type": "boolean" }
          }
        },
        "modelSelectionWizard": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "description": { "type": "string" },
            "docsSource": { "type": "string" },
            "snapshotDate": { "type": "string" },
            "levels": { "type": "object", "additionalProperties": true },
            "domainLevelDefaults": { "type": "object", "additionalProperties": true },
            "supportedCopilotModels": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "provider": { "type": "string" },
                  "releaseStatus": { "type": "string" },
                  "vscodeMinimum": { "type": ["string", "null"] }
                },
                "required": ["id", "name", "provider", "releaseStatus"]
              }
            }
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": {
          "type": "string",
          "enum": ["understand-anything", "graphify", "both"]
        },
        "pluginRoot": { "type": "string" },
        "path": { "type": "string" },
        "graphHtmlPath": { "type": "string" },
        "localGraphPaths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Relative paths to search for local knowledge graphs when using the harness as an external tool. Checked before auto-discovery locations. Example: ['knowledge-graph.json', 'dist/knowledge-graph.json']"
        },
        "localGraphPathsNote": { "type": "string" },
        "sync": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "rebuildVectorIndex": { "type": "boolean" },
            "rebuildMemoryLinkIndex": { "type": "boolean" },
            "continueOnSyncError": { "type": "boolean" }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "eventsPath": { "type": "string" }
          }
        },
        "graphify": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "path": { "type": "string" },
            "graphHtmlPath": { "type": "string" },
            "refreshCommand": { "type": "string" },
            "refreshCwd": { "type": "string" }
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "description": { "type": "string" },
        "lessonsPath": { "type": "string" },
        "briefsPath": { "type": "string" },
        "radarPath": { "type": "string" },
        "localLessonsPaths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Relative paths to search for local lesson files when harness is used as external tool"
        },
        "localBriefsPaths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Relative paths to search for local architecture briefs when harness is used as external tool"
        },
        "localRadarPaths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Relative paths to search for local radar entries (techniques) when harness is used as external tool"
        },
        "localPathsNote": { "type": "string" }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "description": { "type": "string" },
        "runs": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "localPaths": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Relative paths to search for runs directory containing execution journals. Checked in order; first found is used."
            },
            "description": { "type": "string" }
          }
        },
        "loops": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "localPaths": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Relative paths to search for loops directory containing workflow definitions. Checked in order; first found is used."
            },
            "description": { "type": "string" }
          }
        }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": true
    },
    "experiments": {
      "type": "object",
      "additionalProperties": true
    },
    "evolve": {
      "type": "object",
      "additionalProperties": true
    },
    "traceGrading": {
      "type": "object",
      "additionalProperties": true
    },
    "otel": {
      "type": "object",
      "additionalProperties": true
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": true
    },
    "routing": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "defaultMode": { "type": "string" },
        "trivialStartsAt": { "type": "string" },
        "nonTrivialStages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "trivialKeywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "nonTrivialKeywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "taskClassMatrix": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "matchAnyKeywords": {
                "type": "array",
                "items": { "type": "string" }
              },
              "profile": { "type": "string" },
              "modelSet": { "type": "string" }
            },
            "required": ["id", "matchAnyKeywords", "profile"]
          }
        },
        "defaultTaskClass": { "type": "string" },
        "stageModels": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": true,
                "properties": { "model": { "type": "string" } }
              }
            ]
          }
        },
        "stageModelSets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": { "model": { "type": "string" } }
                }
              ]
            }
          }
        },
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "description": { "type": "string" },
              "mode": { "type": "string" },
              "stages": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "required": ["project", "commands"]
}
