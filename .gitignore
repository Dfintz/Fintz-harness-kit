# Dependencies
node_modules/

# Backend build artifacts (compiled TypeScript output and test caches)
backend/dist/
backend/.jest-cache/

# Harness run journals, handoffs, migration receipts, and dashboard output are
# local observability data, not public source. Keep only the directory marker
# and its documented artifact contract.
.github/harness/runs/*
!.github/harness/runs/.gitkeep
!.github/harness/runs/run-contract.md

# OpenTelemetry exports (generated from journals; portable telemetry, not source)
.github/harness/otel/

# Local skill-optimizer reports, checkpoints, logs, and generated candidates
.github/harness/optimization-reports/
.github/harness/optimized-skills/

# Research briefs are UNTRUSTED scraped content — never commit them (the README stays tracked)
.github/harness/research/*
!.github/harness/research/README.md

# Knowledge graph cache (regenerated; optional feature)
.cache/
.pnpm-store/
.understand-anything/
.understand-anything-plugin-placeholder/

# Local config overrides
harness.config.local.json

# OS / editor noise
.DS_Store
*.log

# Editor-local settings (not part of the kit)
.vscode/settings.json
